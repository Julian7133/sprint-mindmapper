{
  "name": "sprint-mindmap-editor",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm ci && npx playwright install chromium",
    "lint": "eslint .",
    "test": "node --test tests/unit/*.test.mjs && node test-roundtrip.mjs ../sprint-tasks.md",
    "pretest:e2e": "playwright install chromium",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.1",
    "eslint": "^10.5.0",
    "globals": "^17.7.0"
  }
}
